#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* Ebene 0: Standard-Modus beim Starten 
           Pins im Array: [D0, D1, D2, D3, D4, D7, D9] */
        default_layer {
            bindings = <
                &kp N1          /* Taste 1 (D0): Schreibt '1' */
                &kp N2          /* Taste 2 (D1): Schreibt '2' */
                &kp N3          /* Taste 3 (D2): Schreibt '3' */
                &kp N4          /* Taste 4 (D3): Schreibt '4' */
                &kp N5          /* Taste 5 (D4): Schreibt '5' */
                &tog 1          /* Taste 6 (D7): SWITCH -> Einmal drücken schaltet Ebene 1 EIN */
                &bt BT_SEL 0    /* Taste 7 (D9): PAIRING -> Einmal drücken aktiviert Bluetooth & sucht PC/Handy */
            >;
        };

        /* Ebene 1: Deine Funktionsebene (Aktiv, nachdem du D7 einmal gedrückt hast) */
        function_layer {
            bindings = <
                &kp F1          /* Taste 1 (D0): Zweitfunktion -> Schreibt 'F1' */
                &kp F2          /* Taste 2 (D1): Zweitfunktion -> Schreibt 'F2' */
                &kp F3          /* Taste 3 (D2): Zweitfunktion -> Schreibt 'F3' */
                &kp F4          /* Taste 4 (D3): Zweitfunktion -> Schreibt 'F4' */
                &kp F5          /* Taste 5 (D4): Zweitfunktion -> Schreibt 'F5' */
                &tog 1          /* Taste 6 (D7): SWITCH -> Einmal drücken schaltet Ebene 1 wieder AUS */
                &bt BT_CLR      /* Taste 7 (D9): RESET -> Löscht die Bluetooth-Verbindung komplett für ein neues Gerät */
            >;
        };
    };
};
