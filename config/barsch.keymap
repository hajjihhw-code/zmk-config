#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    macros {
        // Hilfs-Macro: Wählt Bluetooth Profil 0 aus
        macro_bt_sel_0: macro_bt_sel_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>;
        };

        // Hilfs-Macro: Löscht die aktuelle Bluetooth-Verbindung
        macro_bt_clr: macro_bt_clr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };
    };

    behaviors {
        // Das vom Compiler erzwungene Hold-Tap Verhalten
        bt_hold_clear: bt_hold_clear {
            compatible = "zmk,behavior-hold-tap";
            label = "BT_HOLD_CLEAR";
            #binding-cells = <2>; // Zwingend auf 2 gesetzt, um die Zephyr-Regel zu erfüllen
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&macro_bt_clr>, <&macro_bt_sel_0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Genau 7 Bindings für deine 7 Hardware-Taster.
            // Die '0 0' am Ende sind die Dummy-Werte, die die 2 Binding-Cells bedienen.
            bindings = <
                &kp N1       &kp N2       &kp N3       &kp N4 
                &kp N5       &kp N6       &bt_hold_clear 0 0
            >;
        };
    };
};
