#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        bt_hold: bt_hold_clear {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&bt BT_CLR>, <&bt BT_SEL>;
        };
    };

    macros {
        dbl_click: dbl_click_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp LCLK>, <&macro_wait_time 50>, <&mkp LCLK>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <&mkp LCLK &mmv MOVE_UP &mmv MOVE_DOWN &mmv MOVE_LEFT &mmv MOVE_RIGHT &bt_hold 0 0 &tog 1>;
        };
        layer_1 {
            bindings = <&kp ENTER &kp UP &kp DOWN &kp LEFT &kp RIGHT &bt_hold 0 1 &tog 2>;
        };
        layer_2 {
            bindings = <&kp SPACE &kp ENTER &mkp RCLK &mkp LCLK &dbl_click &bt_hold 0 2 &tog 3>;
        };
        layer_3 {
            bindings = <&kp A &kp B &kp C &kp D &kp E &bt_hold 0 3 &tog 0>;
        };
    };
};
