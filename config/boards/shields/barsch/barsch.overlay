#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/led/led.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,underglow = &led_strip;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        label = "KSCAN";
        /* D0-D4 = Taster, D7 & D9 = BT/Layer-Taster */
        input-gpios = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};

/* SPI Konfiguration für NeoPixel auf D8 und D10 */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,    /* D8 */
                    <NRF_PSEL(SPIM_MOSI, 0, 10)>;  /* D10 */
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 10)>;
            low-power-enable;
        };
    };
};

&spi0 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>; /* Erforderlich für die Adressierung auf dem Bus */
        spi-max-frequency = <4000000>; /* Läuft stabil auf 4 MHz */

        /* Die vom Compiler geforderten exakten Timing-Werte für WS2812-Protokoll */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;

        chain-length = <2>;
        color-mapping = <0x010203>; /* GRB Hard-coded */
    };
};
