#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        /* Verknüpft die Hardware-Pins mit dem ZMK-Tastatur-Scanner */
        zmk,kscan = &kscan0;
        /* Definiert die WS2812-LEDs als Ziel für die RGB-Unterbeleuchtung */
        zmk,underglow = &led_strip;
        /* Verknüpft das physische Layout (wichtig für ZMK Studio) */
        zmk,physical-layout = &default_layout;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        /* Direktes Pin-Mapping für deine 7 Taster am Xiao BLE:
           D0 bis D4 sind die Haupttaster, D7 und D9 für BT/Layer */
        input-gpios = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    /* HINWEIS ZUM 5V-BETRIEB: 
       Da du die NeoPixel direkt an 5V (USB-Strom) hängst, kann ZMK den Strom 
       per Software nicht physisch abschalten. Dieser Block MUSS hier trotzdem 
       stehen, da der RGB-Code von ZMK zwingend nach einem "ext-power"-Knoten 
       sucht. Er dient hier als "Dummy", damit der Compiler fehlerfrei baut. 
       Wir nutzen dafür den internen Pin des Xiao, der sonst die 3.3V-Schiene kappt. */
    ext_power: ext-power {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
    };

    /* Mappt deine 7 direkten Pins in eine virtuelle Matrix-Reihe (1 Reihe, 7 Spalten).
       Das sorgt dafür, dass ZMK die Taster intern sauber verarbeiten kann. */
    direct_transform: direct_transform {
        compatible = "zmk,matrix-transform";
        columns = <7>;
        rows = <1>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)
        >;
    };

    /* Das physische Layout für ZMK Studio. Es teilt der GUI mit, wo die 
       Tasten optisch liegen (Koordinaten in Mikrometer, 100x100 entspricht 1U). */
    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan0>;
        transform = <&direct_transform>;
        keys
            = <&key_physical_attrs 100 100 0 0 0 0 0>
            , <&key_physical_attrs 100 100 100 0 0 0 0>
            , <&key_physical_attrs 100 100 200 0 0 0 0>
            , <&key_physical_attrs 100 100 300 0 0 0 0>
            , <&key_physical_attrs 100 100 400 0 0 0 0>
            , <&key_physical_attrs 100 100 500 0 0 0 0>
            , <&key_physical_attrs 100 100 600 0 0 0 0>
            ;
    };
};

/* SPI-Pin-Konfiguration für die Datenleitung der NeoPixel.
   Wir senden die Daten über den Pin D10 (MOSI) raus. Pin D8 (SCK) läuft leer mit. */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,    /* D8  */
                    <NRF_PSEL(SPIM_MOSI, 0, 10)>;  /* D10 (Datenleitung zu DI der LED) */
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 10)>;
            low-power-enable; /* Stromsparen für die Datenleitung im Sleep-Modus */
        };
    };
};

/* Der SPI-Treiber, der das exakte Protokoll für die WS2812-LEDs erzeugt */
&spi0 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        chain-length = <2>;      /* Du hast 2 NeoPixel verbaut */
        color-mapping = <0x010203>; /* Standard GRB Farb-Reihenfolge für WS2812 */
    };
};
