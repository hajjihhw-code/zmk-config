#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        /* Verknüpft die Hardware-Pins mit dem ZMK-Tastatur-Scanner */
        zmk,kscan = &kscan0;
        /* Definiert die WS2812-LEDs als Ziel für die RGB-Unterbeleuchtung */
        zmk,underglow = &led_strip;
        /* Verknüpft das physische Layout (wichtig für ZMK Studio) */
        zmk,physical-layout = &default_layout;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        /* Direktes Pin-Mapping für deine 7 Taster am Xiao BLE:
           D0 bis D4 sind die Haupttaster, D7 und D9 für BT/Layer */
        input-gpios = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&xiao_d 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    /* FIX: Label von 'ext_power' zu 'ext_power_hardware' geändert, 
       um den Konflikt mit den internen ZMK-Keymap-Befehlen zu lösen. */
    ext_power_hardware: ext-power {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
    };

    /* Mappt deine 7 direkten Pins in eine virtuelle Matrix-Reihe (1 Reihe, 7 Spalten). */
    direct_transform: direct_transform {
        compatible = "zmk,matrix-transform";
        columns = <7>;
        rows = <1>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)
        >;
    };

    /* Das physische Layout für ZMK Studio (Koordinaten in Mikrometer) */
    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan0>;
        transform = <&direct_transform>;
        keys
            = <&key_physical_attrs 100 100 0 0 0 0 0>
            , <&key_physical_attrs 100 100 100 0 0 0 0>
            , <&key_physical_attrs 100 100 200 0 0 0 0>
            , <&key_physical_attrs 100 100 300 0 0 0 0>
            , <&key_physical_attrs 100 100 400 0 0 0 0>
            , <&key_physical_attrs 100 100 500 0 0 0 0>
            , <&key_physical_attrs 100 100 600 0 0 0 0>
            ;
    };
};

/* SPI-Pin-Konfiguration für die Datenleitung der NeoPixel (D10 / MOSI) */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,    /* D8  */
                    <NRF_PSEL(SPIM_MOSI, 0, 10)>;  /* D10 (Datenleitung zu DI der LED) */
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 10)>;
            low-power-enable;
        };
    };
};

/* Der SPI-Treiber für das WS2812-Protokoll */
&spi0 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        chain-length = <2>;
        color-mapping = <0x010203>;
    };
};
